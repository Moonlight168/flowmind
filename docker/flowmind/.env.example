# 复制为 .env 后填写；不要提交真实值。
MYSQL_ROOT_PASSWORD=replace-me
NACOS_AUTH_TOKEN=replace-with-base64-secret-at-least-32-bytes
NACOS_AUTH_IDENTITY_VALUE=replace-me

# 宿主机统一使用五位数端口，避免与本机常用开发服务冲突。
FLOWMIND_HTTP_PORT=18088
LANGFUSE_PORT=13001
LANGFUSE_NEXTAUTH_URL=http://localhost:13001

# ==================== 黄金集评测 ====================
# 测试账号 Bearer Token：AI 服务跑评测实验时以真实登录用户身份调用后端网关。
# 从平台登录后获取，留空则评测脚本报错、服务仍正常启动。
FLOWMIND_AUTH_TOKEN=

LANGFUSE_POSTGRES_USER=flowmind_langfuse
LANGFUSE_POSTGRES_PASSWORD=change-me
LANGFUSE_POSTGRES_DB=langfuse
LANGFUSE_CLICKHOUSE_USER=clickhouse
LANGFUSE_CLICKHOUSE_PASSWORD=change-me
LANGFUSE_REDIS_AUTH=change-me
LANGFUSE_MINIO_ROOT_USER=flowmind
LANGFUSE_MINIO_ROOT_PASSWORD=change-me
LANGFUSE_SALT=change-me
LANGFUSE_ENCRYPTION_KEY=change-me-64-hex-characters
LANGFUSE_NEXTAUTH_SECRET=change-me

LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-change-me
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-change-me
LANGFUSE_INIT_USER_EMAIL=admin@flowmind.local
LANGFUSE_INIT_USER_NAME=FlowMind Admin
LANGFUSE_INIT_USER_PASSWORD=change-me
