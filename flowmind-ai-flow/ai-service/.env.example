# FlowMind AI 服务配置示例
# 复制此文件为 .env 并填写实际值

# ==================== 应用配置 ====================
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
APP_EXECUTION_MODE=invoke
APP_ALLOWED_ORIGINS=["*"]

# ==================== 日志配置 ====================
# 日志级别: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=DEBUG
# 日志格式: simple(简洁) / detailed(详细) / chain(链路)
LOG_FORMAT=chain
# LLM 调用详细级别: none(无) / summary(摘要) / full(完整)
LOG_LLM_DETAIL=summary

# ==================== Langfuse 链路监控 ====================
# 不配置公钥/私钥时自动禁用，不影响业务调用
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Langfuse Cloud 默认地址；私有化部署时改为实际地址
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENABLED=true
LANGFUSE_TRACING_ENVIRONMENT=development
# 黄金数据集脚本使用的测试账号 Bearer Token，仅通过环境注入
FLOWMIND_AUTH_TOKEN=

# ==================== 提示词灰度与紧急回滚 ====================
# 是否启用 versions.json 中的权重灰度；关闭后所有请求使用 stable 版本。
PROMPT_ROLLOUT_ENABLED=false
# JSON 对象：key 为原提示词相对路径，value 为 versions.json 中的版本号。
# 强制版本优先于灰度开关和权重；生产回滚时可将目标提示词指定为稳定版。
PROMPT_VERSION_OVERRIDES={}

# ==================== 模型配置 ====================
# 模型列表（JSON 数组），按优先级从高到低排列
# 字段说明：
#   name: 模型标识名（内部引用）
#   model: 模型名称（API 调用用）
#   base_url: API 地址（OpenAI 兼容格式）
#   api_key: API Key（可选，无 API 无需填写）
#   timeout: 请求超时（秒）
#   thinking: 是否启用深度思考（true/false，部分模型支持）
#   supports_structured_output: 是否支持 ReAct tool-calling + 结构化输出
MODELS=[{"name":"qwen","model":"qwen3.6-flash","base_url":"https://dashscope.aliyuncs.com/compatible-mode/v1","api_key":"your_api_key_here","timeout":60,"thinking":true,"supports_structured_output":true},{"name":"structured_backup","model":"your_structured_model","base_url":"https://your-secondary-provider.example/v1","api_key":"your_secondary_api_key_here","timeout":60,"thinking":false,"supports_structured_output":true},{"name":"vllm","model":"qwen2.5_1.5b_instruct","base_url":"http://localhost:8001/v1","timeout":60,"thinking":false,"supports_structured_output":false}]
MODEL_PRIORITY=qwen,structured_backup,vllm

# ==================== 模型容错配置 ====================
# MAX_RETRIES 表示首选模型之外允许尝试的备用 Provider 数量；受候选数量上限约束。
# RETRY_INTERVAL 表示切换 Provider 前的等待秒数。
# 设计链需要至少两个来自不同故障域、且真实支持 tool-calling 的结构化 Provider。
# structured_backup 是配置模板，部署前必须替换 model/base_url/api_key。
FALLBACK_ENABLED=true
FALLBACK_MAX_RETRIES=3
FALLBACK_RETRY_INTERVAL=1.0

# ==================== 历史压缩与结构化校验 ====================
COMPRESS_MAX_MESSAGES=12
COMPRESS_KEEP_RECENT=4
COMPRESS_ENABLE_LLM_SUMMARY=true
COMPRESS_SUMMARY_MAX_TOKENS=300
VALIDATION_REVIEW_MAX_RETRY_COUNT=3
VALIDATION_STRUCTURED_MAX_RETRY_COUNT=3

# ==================== 数据库配置 ====================
DATABASE_URL=mysql://root:your_password@localhost:13306/flowmind-cloud

# ==================== Redis 配置 ====================
REDIS_HOST=localhost
REDIS_PORT=16379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_CHECKPOINT_TTL_HOURS=24

# ==================== 后端服务配置 ====================
BACKEND_BASE_URL=http://localhost:9001
BACKEND_TIMEOUT=30

# ==================== JWT 配置 ====================
# 必需配置：必须与 Java 后端 RuoYi TokenConstants.SECRET 保持一致（64字节）
# 生产环境请使用随机字符串替代，例：openssl rand -hex 32
JWT_SECRET=abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnop

# ==================== Nacos 配置 ====================
NACOS_ENABLED=true
NACOS_SERVER_ADDR=localhost:18848
NACOS_REGISTER_IP=127.0.0.1
NACOS_REGISTER_PORT=8000
NACOS_MAX_RETRIES=5
NACOS_RETRY_INTERVAL=5.0
